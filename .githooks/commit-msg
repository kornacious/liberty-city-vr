#!/bin/sh
repo_root=$(git rev-parse --show-toplevel) || exit 1
dotnet_path=$(git config --local --get privacy.dotnet) || {
    echo 'Install privacy hooks with: dotnet run --project tools/manager -- --privacy install-hooks' >&2
    exit 1
}
exec "$dotnet_path" run --project "$repo_root/tools/manager/LibertyManager.csproj" -c Release --no-restore -- --privacy message "$1"
