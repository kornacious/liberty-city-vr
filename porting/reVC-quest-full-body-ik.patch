+static bool
+GetBodyIKSettingsPath(char *out, size_t outSize)
+{
+	if(out == nil || outSize == 0)
+		return false;
+
+	const char *root = platform::gameDataRoot();
+	if(root == nil || root[0] == '\0')
+		return false;
+
