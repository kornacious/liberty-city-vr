 inline bool IsRoad(CEntity *e) { return e->IsBuilding() && ((CBuilding*)e)->GetIsATreadable(); }
 
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+// Local remapping only: never mutate visibility or transparent submission lists.
+static CEntity **OrderOpaqueBuildings(CEntity **source, int count, bool roads)
+{
+    if(!rw::vulkan::getOpaqueOrderEnabled() || count<=0) return source;
+#ifndef MASTER
+    if(gbShowCarRoadGroups || gbShowPedRoadGroups) return source;
+#endif
+    static std::vector<CEntity*> ordered;
+    ordered.assign(source, source+count);
+    struct Entry { CEntity *entity; OpaqueOrder::Interval depth{}; bool eligible=false; };
+    for(int start=0;start<count;start+=32){
+        Entry entries[32];
+        const int size=std::min(32,count-start);
+        for(int i=0;i<size;++i){
+            CEntity *e=entries[i].entity=source[start+i];
+            if(!e || !e->IsBuilding() || !e->m_rwObject ||
+               RwObjectGetType(e->m_rwObject)!=rpATOMIC || IsRoad(e)!=roads ||
+               e->bDistanceFade || e->bDrawLast || e->bRenderScorched || e->bRenderDamaged)
+                continue;
+            entries[i].eligible=rw::vulkan::getOpaqueOrderInterval(
+                (rw::Atomic*)e->m_rwObject,entries[i].depth,true)!=0;
+        }
+        rw::vulkan::recordOpaqueOrderSwaps(OpaqueOrder::Sort(entries,size));
+        for(int i=0;i<size;++i) ordered[start+i]=entries[i].entity;
+    }
+    return ordered.data();
+}
+#endif
+
