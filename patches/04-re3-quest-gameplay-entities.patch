+	   !m_aCarNodes[CAR_STEERING_WHEEL]; i++){
+		RwObjectNameAssociation association;
+		association.name = steeringFrameNames[i];
+		association.frame = nil;
+		RwFrameForAllChildren(RpClumpGetFrame(GetClump()),
+			CClumpModelInfo::FindFrameFromNameCB, &association);
