+	// current Modern model archive. Never fall back to interior/chassis frames:
+	// rotating either would turn the dashboard or the whole body with the wheel.
+	static const char *steeringFrameNames[] = {
+		"swheel_hi", "movsteer_1.0", "movsteer"
+	};
