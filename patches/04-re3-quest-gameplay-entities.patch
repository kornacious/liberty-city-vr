+
+#if defined(GTA_VR_WEAPONS) && defined(RW_VULKAN) && defined(__ANDROID__)
+// A gun pointed at you is a threat before it goes off, and in VR that is
+// most of what pointing one is for: the barrel goes wherever the hand
+// goes, and the scan above only hears shots, so a ped could be lined up
+// at arm's length and never notice.
+//
+// The ray is worked out once a frame for the whole world. What is left
+// here is a few dot products on values the ped already holds, cheapest
+// first, and a line of sight that only runs for the one ped the barrel
+// is actually on.
+CPed *
+CPed::CheckForAimedGun(void)
+{
+	CVector source, direction;
+	if (!OculusVR::GetHeldTrackedWeaponAim(&source, &direction))
+		return nil;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || player == this || player->DyingOrDead())
+		return nil;
+
+	// A ped origin already sits at chest height, FEET_OFFSET above the
+	// ground, so the body is the metre or so around it.
+	CVector toUs = GetPosition() - source;
+	const float along = DotProduct(toUs, direction);
+	if (along < 0.5f || along > 25.0f)
+		return nil;
+	// How far the barrel misses by, in metres rather than degrees: a
+	// wave of the hand should not pick someone out down the street, but
+	// across a pavement the whole body counts. Wide enough to cover a
+	// torso, tall enough to cover the rest of the ped.
+	const CVector miss = toUs - along*direction;
+	if (miss.x*miss.x + miss.y*miss.y > sq(0.5f) || Abs(miss.z) > 0.8f)
+		return nil;
+
+	// And the ped has to be facing us. Nobody is frightened by a barrel at
+	// their back, and a ped's own view cone is all the seeing this
+	// needs before the line of sight is worth paying for.
+	CVector2D toPlayer = CVector2D(source) - CVector2D(GetPosition());
+	toPlayer.Normalise();
+	if (DotProduct2D(toPlayer, CVector2D(GetForward())) < 0.5f)
+		return nil;
+
+	if (!OurPedCanSeeThisOne(player))
+		return nil;
+	return player;
+}
+#endif
