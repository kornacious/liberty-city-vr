+// Every other non-null binding in Initialise is the address of one raster.
+// Keep capacities tied to the actual arrays, never to asset configuration.
+static unsigned ParticleRasterCount(RwRaster **frames)
+{
+	if(frames == gpSmokeRaster) return ARRAY_SIZE(gpSmokeRaster);
+	if(frames == gpSmoke2Raster) return ARRAY_SIZE(gpSmoke2Raster);
+	if(frames == gpRubberRaster) return ARRAY_SIZE(gpRubberRaster);
+	if(frames == gpRainSplashRaster) return ARRAY_SIZE(gpRainSplashRaster);
+	if(frames == gpWatersprayRaster) return ARRAY_SIZE(gpWatersprayRaster);
+	if(frames == gpExplosionMediumRaster) return ARRAY_SIZE(gpExplosionMediumRaster);
+	if(frames == gpGunFlashRaster) return ARRAY_SIZE(gpGunFlashRaster);
+	if(frames == gpRainSplashupRaster) return ARRAY_SIZE(gpRainSplashupRaster);
+	if(frames == gpBirdfrontRaster) return ARRAY_SIZE(gpBirdfrontRaster);
+	if(frames == gpCarDebrisRaster) return ARRAY_SIZE(gpCarDebrisRaster);
+	if(frames == gpCarSplashRaster) return ARRAY_SIZE(gpCarSplashRaster);
+	if(frames == gpRainDropRaster) return ARRAY_SIZE(gpRainDropRaster);
+	return frames ? 1u : 0u;
+}
