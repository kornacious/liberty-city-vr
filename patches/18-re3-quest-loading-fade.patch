+#if defined(RW_VULKAN) && defined(__ANDROID__)
+// One fit operation for startup, loading, island screens and the world fade.
+// The swapchain is portrait even when displayed on the landscape theater quad.
+static void
+DrawQuestLoadingArtwork(CSprite2d *splash, const CRGBA &colour)
+{
+	float aspect = 2.0f;
+	if(splash->m_pTexture){
+		RwRaster *raster = RwTextureGetRaster(splash->m_pTexture);
+		if(raster && RwRasterGetWidth(raster) > 0 && RwRasterGetHeight(raster) > 0)
+			aspect = (float)RwRasterGetWidth(raster)/RwRasterGetHeight(raster);
+	}
+	const float displayAspect = 16.0f/9.0f;
+	float width = SCREEN_WIDTH, height = SCREEN_HEIGHT;
+	if(aspect > displayAspect)
+		height *= displayAspect/aspect;
+	else
+		width *= aspect/displayAspect;
+	const float x = (SCREEN_WIDTH - width)*0.5f;
+	const float y = (SCREEN_HEIGHT - height)*0.5f;
+	RwUInt32 srcBlend, dstBlend, vertexAlpha;
+	RwRenderStateGet(rwRENDERSTATESRCBLEND, &srcBlend);
+	RwRenderStateGet(rwRENDERSTATEDESTBLEND, &dstBlend);
+	RwRenderStateGet(rwRENDERSTATEVERTEXALPHAENABLE, &vertexAlpha);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	rw::vulkan::setImmediate2DFullscreen(true, SCREEN_WIDTH, SCREEN_HEIGHT);
+	CSprite2d::DrawRect(CRect(0.0f, 0.0f, SCREEN_WIDTH, SCREEN_HEIGHT),
+		CRGBA(0, 0, 0, colour.a));
+	rw::vulkan::setImmediate2DFullscreen(false, 0, 0);
+	// The backdrop already attenuated the world by (1-alpha). Add the
+	// artwork contribution without attenuating it again: one group fade.
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDONE);
+	rw::vulkan::setImmediate2DLoadingArtwork(true);
+	splash->Draw(CRect(x, y, x + width, y + height), colour, colour, colour, colour);
+	rw::vulkan::setImmediate2DLoadingArtwork(false);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)(size_t)srcBlend);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)(size_t)dstBlend);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)(size_t)vertexAlpha);
+}
+#endif
