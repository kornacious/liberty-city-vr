+static bool
+UpdateQuestJumpHeading(CPed *ped)
+{
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	if(ped != FindPlayerPed() || ped->InVehicle() ||
+	   !androidgame::VrGetOnFootAnimationAngle(nil))
+		return false;
+	float rightRaw[3], forwardRaw[3];
+	if(!androidgame::VrGetViewBasis(nil, rightRaw, nil, forwardRaw))
+		return false;
+	CVector forward(forwardRaw[0], forwardRaw[1], 0.0f);
+	if(forward.MagnitudeSqr() < 0.04f)
+		forward = CVector(-rightRaw[1], rightRaw[0], 0.0f);
+	if(forward.MagnitudeSqr() < 1.0e-8f)
+		return false;
+	float heading = forward.Heading();
+	CPad *pad = CPad::GetPad(0);
+	if(pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0){
+		// CapturePad has already applied physical yaw to the stick once.
+		// Moving jumps use that locomotion vector, relative to the base camera.
+		heading = ped->WorkOutHeadingForMovingFirstPerson(
+			TheCamera.Cams[TheCamera.ActiveCam].Front.Heading());
+	}
+	ped->m_fRotationCur = ped->m_fRotationDest = heading;
+	ped->SetHeading(heading);
+	return true;
+#else
+	(void)ped;
+	return false;
+#endif
+}
