+static void
+UpdateCloudCameraRoll(const CVector &up, const CVector &forward)
+{
+	CVector right = CrossProduct(up, forward);
+	if(right.MagnitudeSqr() <= 0.000001f)
+		return;
+
+	right.Normalise();
+	float c = right.Magnitude2D();
+	if(c > 1.0f)
+		c = 1.0f;
+	CClouds::ms_cameraRoll = Acos(c);
+	if(right.z < 0.0f)
+		CClouds::ms_cameraRoll = -CClouds::ms_cameraRoll;
+}
+
 void
 CClouds::Init(void)
 {
@@ -137,6 +295,33 @@ CClouds::Render(void)
 
 	int minute = CClock::GetHours()*60 + CClock::GetMinutes();
 	RwV3d campos = TheCamera.GetPosition();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	// The desktop VR renderer temporarily puts its eye camera in TheCamera
+	// before drawing sky sprites. Native Quest keeps the simulation camera in
+	// TheCamera and writes the post-physics first-person view into Scene.camera
+	// instead. Using the former as the origin made the moon and star field
+	// inherit the removed chase-camera gait/bob while their projection used
+	// the VR view matrix. Use the actual rendered camera origin for the same
+	// camera-relative construction as desktop.
+	if(gVrFirstPersonActive && Scene.camera != nil){
+		RwFrame *frame = RwCameraGetFrame(Scene.camera);
+		if(frame != nil){
+			RwMatrix *camera = RwFrameGetLTM(frame);
+			campos = *RwMatrixGetPos(camera);
+
+			// RenderBackground normally refreshes this value from TheCamera.
+			// Quest deliberately skips that flat full-screen sky pass, while
+			// the actual HMD orientation lives in Scene.camera. Without the
+			// matching roll compensation the screen-facing cloud sprites turn
+			// with the player's head instead of remaining fixed in the world.
+			RwV3d *cameraUp = RwMatrixGetUp(camera);
+			RwV3d *cameraForward = RwMatrixGetAt(camera);
+			UpdateCloudCameraRoll(
+				CVector(cameraUp->x, cameraUp->y, cameraUp->z),
+				CVector(cameraForward->x, cameraForward->y, cameraForward->z));
+		}
+	}
+#endif
 
 	// Moon
 	int moonfadeout = Abs(minute - 180);	// fully visible at 3AM
@@ -206,6 +391,10 @@ CClouds::Render(void)
 	int r = CTimeCycle::GetLowCloudsRed() * lowcloudintensity;
 	int g = CTimeCycle::GetLowCloudsGreen() * lowcloudintensity;
