@@ -126,6 +126,19 @@ EnvMapRender(void)
 	if(VehiclePipeSwitch != VEHICLEPIPE_NEO)
 		return;
 
+	// Save loading tears the old world down before GenericLoad creates the new
+	// player ped.  Keep the main camera update active and skip this optional
+	// reflection refresh during that valid transition frame; FindPlayerCoors
+	// assumes a live player and would otherwise dereference a null ped here.
+	if(FindPlayerPed() == nil)
+		return;
+
+	// Refreshing the low-frequency vehicle reflection by rendering the complete
+	// world every frame is disproportionately expensive on the mobile tiler.
+	static uint32 envMapFrameCounter;
+	if(++envMapFrameCounter % 9 != 1)
+		return;
+
 	RwCameraEndUpdate(Scene.camera);
 
