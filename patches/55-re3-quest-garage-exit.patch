 bool CGarage::IsEntityEntirelyOutside(CEntity * pEntity, float fMargin)
 {
+#ifdef __ANDROID__
+	if (pEntity == FindPlayerPed()) {
+		float eye[3];
+		const bool haveEye = androidgame::VrGetViewBasis(eye, nil, nil, nil);
+		// Room-scale head movement is independent of the collision body.
+		if (haveEye &&
+			eye[0] >= m_fX1 - fMargin && eye[0] <= m_fX2 + fMargin &&
+			eye[1] >= m_fY1 - fMargin && eye[1] <= m_fY2 + fMargin)
+			return false;
+
+		// Leaving a scripted acceptance rectangle through a side/back edge
+		// does not mean leaving the physical garage. A mission delivery must
+		// put both the player and the eye beyond an actual doorway.
+		if (m_eGarageType == GARAGE_MISSION && fMargin > 0.0f && (m_pDoor1 || m_pDoor2)) {
+			bool clearedDoor = false;
+			for (int door = 0; door < 2; door++) {
+				if (!(door == 0 ? m_pDoor1 : m_pDoor2))
+					continue;
+				const float x = door == 0 ? m_fDoor1X : m_fDoor2X;
+				const float y = door == 0 ? m_fDoor1Y : m_fDoor2Y;
+				const float dx = x - GetGarageCenterX();
+				const float dy = y - GetGarageCenterY();
+				// Garage rectangles are axis aligned. Use the nearest face's
+				// outward direction, independent of the door mesh orientation.
+				const bool xFace = Abs(dx) * (m_fY2 - m_fY1) >= Abs(dy) * (m_fX2 - m_fX1);
+				const float direction = (xFace ? dx : dy) < 0.0f ? -1.0f : 1.0f;
+				const float doorAxis = xFace ? x : y;
+				const float bodyAxis = xFace ? pEntity->GetPosition().x : pEntity->GetPosition().y;
+				const float eyeAxis = haveEye ? (xFace ? eye[0] : eye[1]) : bodyAxis;
+				if ((bodyAxis - doorAxis) * direction > fMargin &&
+					(eyeAxis - doorAxis) * direction > fMargin)
+					clearedDoor = true;
+			}
+			if (!clearedDoor)
+				return false;
+		}
+	}
+#endif
 	if (pEntity->GetPosition().x > m_fX1 - fMargin && pEntity->GetPosition().x < m_fX2 + fMargin &&
 		pEntity->GetPosition().y > m_fY1 - fMargin && pEntity->GetPosition().y < m_fY2 + fMargin)
 		return false;
