+#if defined(RW_VULKAN) && defined(__ANDROID__)
+static void PrepareVrWorldOcclusion(CEntity **entities,int count,const CVector &camera)
+{
+    using namespace rw::vulkan;
+    if(!getWorldOcclusionEnabled())return;
+#ifdef NEW_RENDERER
+    if(gbNewRenderer)return; // Alternate building queues retain original rendering.
+#endif
+#ifndef MASTER
+    if(gbShowCollisionPolys||gbShowCarRoadGroups||gbShowPedRoadGroups||gbDontRenderBuildings||gbDontRenderBigBuildings)return;
+#endif
+    if(!beginWorldOcclusion())return;
+    struct Candidate {float priority;CEntity *entity;};
+    static std::vector<Candidate> candidates;
+    candidates.clear();
+    try {
+        for(int i=0;i<count;++i){
+            CEntity *e=entities[i];
+            if(!e||!e->IsBuilding()||!e->bIsVisible||!e->m_rwObject||
+               RwObjectGetType(e->m_rwObject)!=rpATOMIC||e->bDistanceFade||e->bDrawLast||e->bRenderDamaged||e->bRenderScorched)continue;
+            if(!CRenderer::ShouldRenderInCurrentView(e))continue;
+            auto *mi=CModelInfo::GetModelInfo(e->GetModelIndex());
+            if(!mi||!mi->IsSimple())continue;
+            auto *simple=(CSimpleModelInfo*)mi;
+            if(simple->m_alpha!=255||simple->m_noZwrite||simple->m_additive||simple->m_drawLast)continue;
+            const float r=e->GetBoundRadius();
+            const float squared=(e->GetPosition()-camera).MagnitudeSqr();
+            const float priority=r*r/(squared+1.0f)/(1.0f+sqrtf(squared)*0.005f);
+            if(!std::isfinite(priority))continue;
+            candidates.push_back({priority,e});
+        }
+        const unsigned limit=std::min(unsigned(candidates.size()),128u);
+        std::partial_sort(candidates.begin(),candidates.begin()+limit,candidates.end(),[](const Candidate &a,const Candidate &b){return a.priority>b.priority;});
+        for(unsigned i=0;i<limit;++i)addWorldOccluder((rw::Atomic*)candidates[i].entity->m_rwObject);
+    }catch(const std::bad_alloc&){ /* A partial conservative map is still valid. */ }
+    finishWorldOcclusion();
+}
+#endif
+
