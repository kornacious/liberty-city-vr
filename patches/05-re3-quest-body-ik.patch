+static RwObject*
+SetHeadAtomicRenderFlagCB(RwObject *object, void *data)
+{
+	RpAtomic *atomic = (RpAtomic*)object;
+	bool render = *(bool*)data;
+	RwUInt32 flags = RpAtomicGetFlags(atomic);
+	if (render)
+		flags |= rpATOMICRENDER;
+	else
+		flags &= ~rpATOMICRENDER;
+	RpAtomicSetFlags(atomic, flags);
+	return object;
+}
+
+static RwObject*
+SetWeaponAtomicRenderFlagCB(RwObject *object, void *data)
+{
+	RpAtomic *atomic = (RpAtomic*)object;
+	if (CVisibilityPlugins::GetAtomicModelInfo(atomic)) {
+		bool render = *(bool*)data;
+		RwUInt32 flags = RpAtomicGetFlags(atomic);
+		if (render)
+			flags |= rpATOMICRENDER;
+		else
+			flags &= ~rpATOMICRENDER;
+		RpAtomicSetFlags(atomic, flags);
+	}
+	return object;
+}
