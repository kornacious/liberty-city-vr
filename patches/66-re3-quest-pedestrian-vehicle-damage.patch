diff --git a/src/entities/Physical.cpp b/src/entities/Physical.cpp
--- a/src/entities/Physical.cpp
+++ b/src/entities/Physical.cpp
@@ -242,5 +242,14 @@
 CPhysical::SetDamagedPieceRecord(uint16 piece, float impulse, CEntity *entity, CVector dir)
 {
+#ifdef FIX_BUGS
+	// Pedestrian collision response uses artificial mass factors to keep bodies
+	// and cars apart. Its impulses are not weapon strikes and must not dent cars
+	// on every frame while a pedestrian walks/runs into them. Filter before
+	// selecting the strongest damage record, so a body contact cannot overwrite
+	// a real crash. Melee damage goes directly through VehicleDamage instead.
+	if(IsVehicle() && entity->IsPed())
+		return;
+#endif
 	m_nDamagePieceType = piece;
 	m_fDamageImpulse = impulse;
 	m_pDamageEntity = entity;
