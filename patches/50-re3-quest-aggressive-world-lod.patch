+// Aggressive transitions are per entity/distance, never stored in the shared
+// model alpha: instances of one model can be on opposite sides of a cutoff.
+static int32
+SetupAggressiveWorldVisibility(CEntity *ent,CSimpleModelInfo *mi,float dist,bool outside,bool request)
+{
+    const auto plan=VrWorldLod::GetTransition(mi,dist);
+    ent->bDistanceFade=false;
+    if(!plan.count){
+        const float limit=VrWorldLod::LargestDistance(mi);
+        return request && dist < limit+FADE_DISTANCE+STREAM_DISTANCE ? VIS_STREAMME:VIS_INVISIBLE;
+    }
+    if(!ent->m_rwObject)ent->CreateRwObject();
+    if(!ent->m_rwObject||!ent->bIsVisible)return VIS_INVISIBLE;
+    auto *atomic=(RpAtomic*)ent->m_rwObject;
+    RpAtomicSetGeometry(atomic,RpAtomicGetGeometry(plan.layers[0].atomic),rpATOMICSAMEBOUNDINGSPHERE);
+    mi->IncreaseAlpha();
+    if(outside)return VIS_OFFSCREEN;
+    if(plan.fading||mi->m_alpha!=255){
+        if(CVisibilityPlugins::InsertEntityIntoSortedList(ent,dist)){
+            ent->bDistanceFade=true;return VIS_INVISIBLE;
+        }
+        // Capacity fallback keeps scenery present rather than dropping it.
+        return VIS_VISIBLE;
+    }
+    if(mi->m_drawLast||ent->bDrawLast){
+        if(CVisibilityPlugins::InsertEntityIntoSortedList(ent,dist))return VIS_INVISIBLE;
+    }
+    return VIS_VISIBLE;
+}
