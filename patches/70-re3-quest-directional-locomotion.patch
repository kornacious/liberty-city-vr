+static bool
+UseQuestDirectionalLocomotion(CPlayerPed *player)
+{
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	return !player->InVehicle() && !player->bIsInTheAir &&
+		player->m_nPedState != PED_JUMP && player->CanStrafeOrMouseControl() &&
+		androidgame::VrGetOnFootAnimationAngle(nil);
+#else
+	(void)player;
+	return false;
+#endif
+}
+
+static bool
+BlendQuestLocomotionToIdle(CPlayerPed *player)
+{
+	if(!UseQuestDirectionalLocomotion(player) || player->bIsDucking)
+		return false;
+	if(player->m_fMoveSpeed != 0.0f){
+		// A new deflection can arrive before the idle crossfade finishes.
+		// Resume the frozen gait without leaving its fade/delete state armed.
+		const AnimationId gait[] = { ANIM_STD_WALK, ANIM_STD_RUN,
+			ANIM_STD_RUNFAST, ANIM_STD_STARTWALK };
+		for(unsigned int i = 0; i < sizeof(gait)/sizeof(gait[0]); i++){
+			CAnimBlendAssociation *anim = RpAnimBlendClumpGetAssociation(player->GetClump(), gait[i]);
+			if(anim && !anim->IsRunning() && anim->blendDelta < 0.0f){
+				anim->flags &= ~ASSOC_DELETEFADEDOUT;
+				anim->blendDelta = 0.0f;
+				anim->SetRun();
+			}
+		}
+		return false;
+	}
+
+	// The stock RUNSTOP clips translate forwards, regardless of the last
+	// movement group. Freeze the last directional gait and crossfade to idle
+	// instead of introducing a forward step or blocking fresh stick input.
+	const AnimationId moving[] = { ANIM_STD_WALK, ANIM_STD_RUN,
+		ANIM_STD_RUNFAST, ANIM_STD_STARTWALK, ANIM_STD_RUNSTOP1, ANIM_STD_RUNSTOP2 };
+	for(unsigned int i = 0; i < sizeof(moving)/sizeof(moving[0]); i++){
+		CAnimBlendAssociation *anim = RpAnimBlendClumpGetAssociation(player->GetClump(), moving[i]);
+		if(anim){
+			anim->flags &= ~ASSOC_RUNNING;
+			anim->flags |= ASSOC_DELETEFADEDOUT;
+			anim->blendDelta = -8.0f;
+		}
+	}
+	CAnimManager::BlendAnimation(player->GetClump(), player->m_animGroup, ANIM_STD_IDLE, 8.0f);
+	player->m_nMoveState = PEDMOVE_STILL;
+	player->RestoreHeadingRate();
+	return true;
+}
