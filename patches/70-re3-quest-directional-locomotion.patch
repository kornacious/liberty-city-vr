+static bool
+ApplyQuestMovementVelocity(CPed *ped)
+{
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	if(ped != FindPlayerPed() || ped->InVehicle() || ped->bIsInTheAir ||
+	   ped->m_nPedState == PED_JUMP || !ped->CanStrafeOrMouseControl() ||
+	   !androidgame::VrGetOnFootAnimationAngle(nil))
+		return false;
+
+	CPad *pad = CPad::GetPad(0);
+	float speed = ped->m_moved.Magnitude();
+	if(pad->GetPedWalkLeftRight() == 0 && pad->GetPedWalkUpDown() == 0)
+		speed = 0.0f;
+	const float heading = ped->WorkOutHeadingForMovingFirstPerson(
+		TheCamera.Cams[TheCamera.ActiveCam].Front.Heading());
+	// Directional clips carry signed lateral/backwards root motion. Use
+	// its magnitude exactly once and keep the existing head-relative path.
+	ped->m_moved = CVector2D(-Sin(heading), Cos(heading))*speed;
+	TheCamera.Cams[TheCamera.ActiveCam].m_fPlayerVelocity = speed;
+	// Do not run the stock thigh-twist pass on top of the directional pose.
+	return true;
+#else
+	(void)ped;
+	return false;
+#endif
+}
