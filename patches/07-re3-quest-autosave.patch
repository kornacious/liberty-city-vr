+bool
+CheckDataNotCorrupt(int32 slot, char *name)
+{
+	char filename[sizeof(LoadFileName)];
+	if(!GetSaveFileName(slot, filename, sizeof(filename)))
+		return false;
+	if(CheckSaveFile(filename, name, slot))
+		return true;
+	if(slot != AUTOSAVE_SLOT)
+		return false;
+	char backup[sizeof(LoadFileName)];
+	const int length = snprintf(backup, sizeof(backup), "%s.bak", filename);
+	if(length >= 0 && size_t(length) < sizeof(backup) && CheckSaveFile(backup, name, slot)){
+		PcSaveHelper.nErrorCode = SAVESTATUS_SUCCESSFUL;
+		return true;
+	}
 	return false;
 }
 
