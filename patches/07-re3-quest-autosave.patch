+bool
+GetSaveFileName(int32 slot, char *destination, size_t capacity)
+{
+	if(slot < AUTOSAVE_SLOT || slot > SLOT_COUNT || capacity == 0)
+		return false;
+	const int length = slot == AUTOSAVE_SLOT ?
+		snprintf(destination, capacity, "%sautosave.b", DefaultPCSaveFileName) :
+		snprintf(destination, capacity, "%s%d.b", DefaultPCSaveFileName, slot + 1);
+	// Reserve room for the longest staging suffix before any file is opened.
+	const size_t suffix = slot == AUTOSAVE_SLOT ? sizeof(".bak.tmp") - 1 : 0;
+	if(length < 0 || size_t(length) >= capacity || size_t(length) + suffix >= sizeof(LoadFileName)){
+		destination[0] = '\0';
+		return false;
+	}
+#ifdef __ANDROID__
+	for(char *p = destination; *p; ++p)
+		if(*p == '\\') *p = '/';
+#endif
+	return true;
+}
