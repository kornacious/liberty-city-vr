+#ifdef __ANDROID__
+namespace {
+struct AutosaveOperations {
+	bool Write(const char *path) {
+		const int file = CFileMgr::OpenFile(path, "wb");
+		if(file == 0) return false;
+		const bool written = GenericSave(file);
+		// GenericSave closes on some failures. Closing again is harmless in
+		// CFileMgr and releases the handle on every other failure path.
+		const bool closed = CFileMgr::CloseFile(file) == 0;
+		return written && closed;
+	}
+	bool Exists(const char *path) {
+		struct stat info;
+		return stat(path, &info) == 0;
+	}
+	bool Validate(const char *path) {
+		char name[sizeof(LoadFileName)];
+		const int checksum = CheckSum;
+		const eLevelName level = m_LevelToLoad;
+		const auto error = PcSaveHelper.nErrorCode;
+		const bool valid = CheckSaveFile(path, name, AUTOSAVE_SLOT);
+		CheckSum = checksum;
+		m_LevelToLoad = level;
+		PcSaveHelper.nErrorCode = error;
+		return valid;
+	}
+	bool Sync(const char *path) {
+		const int file = open(path, O_RDWR);
+		if(file < 0) return false;
+		const bool synced = fsync(file) == 0;
+		const bool closed = close(file) == 0;
+		return synced && closed;
+	}
+	bool Copy(const char *source, const char *destination) {
+		FILE *input = fopen(source, "rb");
+		if(!input) return false;
+		FILE *output = fopen(destination, "wb");
+		if(!output){ fclose(input); return false; }
+		char buffer[16384];
+		bool copied = true;
+		size_t count;
+		while((count = fread(buffer, 1, sizeof(buffer), input)) != 0)
+			if(fwrite(buffer, 1, count, output) != count){ copied = false; break; }
+		if(ferror(input)) copied = false;
+		const bool inputClosed = fclose(input) == 0;
+		const bool outputClosed = fclose(output) == 0;
+		return copied && inputClosed && outputClosed;
+	}
+	bool Replace(const char *source, const char *destination) {
+		return rename(source, destination) == 0;
+	}
+	bool SyncDirectory(const char *path) {
+		char directory[260];
+		const int length = snprintf(directory, sizeof(directory), "%s", path);
+		if(length < 0 || size_t(length) >= sizeof(directory)) return false;
+		char *slash = strrchr(directory, '/');
+		if(slash) { if(slash == directory) slash[1] = '\0'; else *slash = '\0'; }
+		else strcpy(directory, ".");
+		const int file = open(directory, O_RDONLY | O_DIRECTORY);
+		if(file < 0) return false;
+		const int result = fsync(file);
+		const int error = errno;
+		close(file);
+		// Some emulated-storage providers do not expose directory fsync.
+		// File fsync and atomic replacement are still required above.
+		if(result != 0 && (error == EINVAL || error == EOPNOTSUPP)){
+			SAVELOG("autosave directory fsync unavailable: %d", error);
+			return true;
+		}
+		return result == 0;
+	}
+	void Remove(const char *path) { unlink(path); }
+};
+}
+#endif
+
+bool
+AutoSaveGame(void)
+{
+	if (CPad::bMissionCheatUsed) {
+		SAVELOG("AutoSaveGame skipped: VR mission cheat was used");
+		return false;
+	}
+	if (gGameState != GS_PLAYING_GAME) {
+		SAVELOG("AutoSaveGame skipped: gameState=%d", gGameState);
+		return false;
+	}
+	CPlayerInfo *pPlayerInfo = &CWorld::Players[CWorld::PlayerInFocus];
+	if (!pPlayerInfo || !pPlayerInfo->m_pPed) {
+		SAVELOG("AutoSaveGame skipped: no player ped");
+		return false;
+	}
+	if (pPlayerInfo->m_WBState != WBSTATE_PLAYING) {
+		SAVELOG("AutoSaveGame skipped: wbState=%d", pPlayerInfo->m_WBState);
+		return false;
+	}
+	if (pPlayerInfo->m_pPed->GetPedState() == PED_DEAD ||
+	    pPlayerInfo->m_pPed->GetPedState() == PED_ARRESTED) {
+		SAVELOG("AutoSaveGame skipped: pedState=%d", pPlayerInfo->m_pPed->GetPedState());
+		return false;
+	}
+	if (pPlayerInfo->IsRestartingAfterDeath() || pPlayerInfo->IsRestartingAfterArrest()) {
+		SAVELOG("AutoSaveGame skipped: restarting after death/arrest");
+		return false;
+	}
+	if (CTheScripts::FailCurrentMission != 0) {
+		SAVELOG("AutoSaveGame skipped: FailCurrentMission set");
+		return false;
+	}
+	if (CTheScripts::IsPlayerOnAMission()) {
+		SAVELOG("AutoSaveGame skipped: still on a mission");
+		return false;
+	}
+	if (CStats::LastMissionPassedName[0] == '\0') {
+		SAVELOG("AutoSaveGame skipped: LastMissionPassedName is empty");
+		return false;
+	}
+
+	const int8 previousQuickSave = IsQuickSave;
+	IsQuickSave = SAVE_TYPE_QUICKSAVE;
+	MakeValidSaveName(AUTOSAVE_SLOT);
+	PcSaveHelper.nErrorCode = SAVESTATUS_SUCCESSFUL;
+#ifdef __ANDROID__
+	AutosaveOperations operations;
+	const bool res = ValidSaveName[0] != '\0' && AutosaveTransaction::Save(operations, ValidSaveName);
+#else
+	const bool res = false;
+#endif
+	IsQuickSave = previousQuickSave;
+
+	SAVELOG("AutoSaveGame result=%d slot=%d file=%s mission=%s",
+	        res, AUTOSAVE_SLOT + 1, ValidSaveName, CStats::LastMissionPassedName);
+
+	if (res) {
+		wchar msg[64];
+		AsciiToUnicode("~g~AUTOSAVE COMPLETED", msg);
+		CHud::SetHelpMessage(msg, true);
+		DMAudio.PlayFrontEndSound(SOUND_FRONTEND_MENU_SETTING_CHANGE, 0);
+	}else{
+		PcSaveHelper.nErrorCode = SAVESTATUS_ERR_SAVE_WRITE;
+		wchar msg[80];
+		AsciiToUnicode("~r~AUTOSAVE FAILED - PREVIOUS SAVE KEPT", msg);
+		CHud::SetHelpMessage(msg, true);
+	}
+	return res;
+}
+#endif
