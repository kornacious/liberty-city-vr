+
+bool
+AutoSaveGame(void)
+{
+	if (CPad::bMissionCheatUsed) {
+		SAVELOG("AutoSaveGame skipped: VR mission cheat was used");
+		return false;
+	}
+	if (gGameState != GS_PLAYING_GAME) {
+		SAVELOG("AutoSaveGame skipped: gameState=%d", gGameState);
+		return false;
+	}
+	CPlayerInfo *pPlayerInfo = &CWorld::Players[CWorld::PlayerInFocus];
+	if (!pPlayerInfo || !pPlayerInfo->m_pPed) {
+		SAVELOG("AutoSaveGame skipped: no player ped");
+		return false;
+	}
+	if (pPlayerInfo->m_WBState != WBSTATE_PLAYING) {
+		SAVELOG("AutoSaveGame skipped: wbState=%d", pPlayerInfo->m_WBState);
+		return false;
+	}
+	if (pPlayerInfo->m_pPed->GetPedState() == PED_DEAD ||
+	    pPlayerInfo->m_pPed->GetPedState() == PED_ARRESTED) {
+		SAVELOG("AutoSaveGame skipped: pedState=%d", pPlayerInfo->m_pPed->GetPedState());
+		return false;
+	}
+	if (pPlayerInfo->IsRestartingAfterDeath() || pPlayerInfo->IsRestartingAfterArrest()) {
+		SAVELOG("AutoSaveGame skipped: restarting after death/arrest");
+		return false;
+	}
+	if (CTheScripts::FailCurrentMission != 0) {
+		SAVELOG("AutoSaveGame skipped: FailCurrentMission set");
+		return false;
+	}
+	if (CTheScripts::IsPlayerOnAMission()) {
+		SAVELOG("AutoSaveGame skipped: still on a mission");
+		return false;
+	}
+	if (CStats::LastMissionPassedName[0] == '\0') {
+		SAVELOG("AutoSaveGame skipped: LastMissionPassedName is empty");
+		return false;
+	}
+
+	IsQuickSave = SAVE_TYPE_QUICKSAVE;
+	const int AUTOSAVE_SLOT = 0; // Slot 1 (GTA3sf1.b)
+	bool res = PcSaveHelper.SaveSlot(AUTOSAVE_SLOT);
+	PcSaveHelper.PopulateSlotInfo();
+	IsQuickSave = SAVE_TYPE_NONE;
+
+	SAVELOG("AutoSaveGame result=%d slot=%d file=%s mission=%s",
+	        res, AUTOSAVE_SLOT + 1, ValidSaveName, CStats::LastMissionPassedName);
+
+	if (res) {
+		wchar msg[64];
+		AsciiToUnicode("~g~AUTOSAVE COMPLETED", msg);
+		CHud::SetHelpMessage(msg, true);
+		DMAudio.PlayFrontEndSound(SOUND_FRONTEND_MENU_SETTING_CHANGE, 0);
+	}
+	return res;
+}
 #endif
