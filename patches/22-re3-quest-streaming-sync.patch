+static queststream::Queue gQuestCdStream;
+static_assert(queststream::Queue::Idle == STREAM_NONE &&
+              queststream::Queue::Accepted == STREAM_SUCCESS &&
+              queststream::Queue::Error == STREAM_ERROR &&
+              queststream::Queue::Reading == STREAM_READING &&
+              queststream::Queue::Waiting == STREAM_WAITING,
+              "Quest streaming status must match the engine");
+
+static bool
+QuestReadImage(int fd, void *buffer, size_t bytes, uint64_t offset, void *)
+{
+    size_t completed = 0;
+    while(completed < bytes){
+        const ssize_t count = pread(fd, static_cast<char *>(buffer) + completed,
+                                    bytes - completed, offset + completed);
+        if(count < 0 && errno == EINTR) continue;
+        if(count <= 0) return false;
+        completed += static_cast<size_t>(count);
+    }
+    return true;
+}
