 static void
 UpdateCloudCameraRoll(const CVector &up, const CVector &forward)
 {
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	// Quest world sprites now use a world-up basis in FaceQuestWorldSprite.
+	// Keep authored cloud rotation, without applying camera roll twice.
+	if(!androidgame::VrShouldUseTheaterMode()){
+		CClouds::ms_cameraRoll = 0.0f;
+		return;
+	}
+#endif
 	CVector right = CrossProduct(up, forward);
 	if(right.MagnitudeSqr() <= 0.000001f)
 		return;
