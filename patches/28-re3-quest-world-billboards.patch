+static bool
+QuestWorldBillboardsEnabled(void)
+{
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	return !androidgame::VrShouldUseTheaterMode();
+#else
+	return false;
+#endif
+}
+
+static void
+FaceQuestWorldSprite(RwIm2DVertex *vertices, int count, float x, float y)
+{
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	if(QuestWorldBillboardsEnabled()){
+		const RwV2d *window = RwCameraGetViewWindow(Scene.camera);
+		const RwMatrix *camera = RwFrameGetLTM(RwCameraGetFrame(Scene.camera));
+		const float worldUp[3] = { -camera->right.z, camera->up.z, camera->at.z };
+		const float worldEast[3] = { -camera->right.x, camera->up.x, camera->at.x };
+		// RenderWare right points left; the helper uses camera right/up/forward.
+		// World axes keep texture orientation independent of headset roll.
+		QuestBillboard::FaceViewer(vertices, count, x, y,
+			SCREEN_WIDTH, SCREEN_HEIGHT, window->x, window->y, worldUp, worldEast);
+	}
+#else
+	(void)vertices; (void)count; (void)x; (void)y;
+#endif
+}
