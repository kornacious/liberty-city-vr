+{
+	char resolved[1024];
+	const char *selected = ModelSets::ResolveAssetPath(filename, resolved,
+		sizeof(resolved));
+#ifndef _WIN32
+	char *real = casepath(selected, false);
+	const char *openPath = real ? real : selected;
+#else
+	const char *openPath = selected;
+#endif
+	RwStream *stream = RwStreamOpen(rwSTREAMFILENAME, rwSTREAMREAD, openPath);
+#ifndef _WIN32
+	if(real)
+		free(real);
+#endif
+	if(!stream && selected != filename){
+#ifndef _WIN32
+		char *origReal = casepath(filename, false);
+		const char *origOpenPath = origReal ? origReal : filename;
+#else
+		const char *origOpenPath = filename;
+#endif
+		stream = RwStreamOpen(rwSTREAMFILENAME, rwSTREAMREAD, origOpenPath);
+#ifndef _WIN32
+		if(origReal)
+			free(origReal);
+#endif
+	}
+	return stream;
+}
 
