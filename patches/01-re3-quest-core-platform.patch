+	if(index == VR_SPECIAL_CAR_INVINCIBILITY)
+		return gVrCarInvincibilityEnabled ?
+			"CAR INVINCIBILITY - ON" : "CAR INVINCIBILITY - OFF";
+	const int legacy = index-VR_SPECIAL_CHEAT_COUNT;
+	return legacy >= 0 && legacy < (int)ARRAY_SIZE(gVrCheatNames) ?
+		gVrCheatNames[legacy] : "UNKNOWN";
+}
