+static eWeaponType GetWeaponTypeForSlot(int slot)
+{
+	switch(slot){
+	case WEAPONSLOT_UNARMED: return WEAPONTYPE_UNARMED;
+	case WEAPONSLOT_MELEE: return WEAPONTYPE_BASEBALLBAT;
+	case WEAPONSLOT_PROJECTILE: {
+		CPed *player = FindPlayerPed();
+		if(player){
+			if(player->GetWeapon() &&
+			   (player->GetWeapon()->m_eWeaponType == WEAPONTYPE_MOLOTOV ||
+			    player->GetWeapon()->m_eWeaponType == WEAPONTYPE_GRENADE) &&
+			   player->HasWeapon(player->GetWeapon()->m_eWeaponType))
+				return player->GetWeapon()->m_eWeaponType;
+			if(player->HasWeapon(WEAPONTYPE_MOLOTOV) && player->GetWeapon(WEAPONTYPE_MOLOTOV).m_nAmmoTotal > 0)
+				return WEAPONTYPE_MOLOTOV;
+			if(player->HasWeapon(WEAPONTYPE_GRENADE) && player->GetWeapon(WEAPONTYPE_GRENADE).m_nAmmoTotal > 0)
+				return WEAPONTYPE_GRENADE;
+			if(player->HasWeapon(WEAPONTYPE_MOLOTOV)) return WEAPONTYPE_MOLOTOV;
+		}
+		return WEAPONTYPE_GRENADE;
+	}
+	case WEAPONSLOT_HANDGUN: return WEAPONTYPE_COLT45;
+	case WEAPONSLOT_SHOTGUN: return WEAPONTYPE_SHOTGUN;
+	case WEAPONSLOT_SUBMACHINEGUN: return WEAPONTYPE_UZI;
+	case WEAPONSLOT_RIFLE: {
+		CPed *player = FindPlayerPed();
+		if(player){
+			if(player->GetWeapon() &&
+			   (player->GetWeapon()->m_eWeaponType == WEAPONTYPE_M16 ||
+			    player->GetWeapon()->m_eWeaponType == WEAPONTYPE_AK47) &&
+			   player->HasWeapon(player->GetWeapon()->m_eWeaponType))
+				return player->GetWeapon()->m_eWeaponType;
+			if(player->HasWeapon(WEAPONTYPE_M16)) return WEAPONTYPE_M16;
+			if(player->HasWeapon(WEAPONTYPE_AK47)) return WEAPONTYPE_AK47;
+		}
+		return WEAPONTYPE_AK47;
+	}
+	case WEAPONSLOT_HEAVY: {
+		CPed *player = FindPlayerPed();
+		if(player){
+			if(player->GetWeapon() &&
+			   (player->GetWeapon()->m_eWeaponType == WEAPONTYPE_FLAMETHROWER ||
+			    player->GetWeapon()->m_eWeaponType == WEAPONTYPE_ROCKETLAUNCHER) &&
+			   player->HasWeapon(player->GetWeapon()->m_eWeaponType))
+				return player->GetWeapon()->m_eWeaponType;
+			if(player->HasWeapon(WEAPONTYPE_FLAMETHROWER)) return WEAPONTYPE_FLAMETHROWER;
+			if(player->HasWeapon(WEAPONTYPE_ROCKETLAUNCHER)) return WEAPONTYPE_ROCKETLAUNCHER;
+		}
+		return WEAPONTYPE_ROCKETLAUNCHER;
+	}
+	case WEAPONSLOT_SNIPER: return WEAPONTYPE_SNIPERRIFLE;
+	case WEAPONSLOT_OTHER: return WEAPONTYPE_DETONATOR;
+	default: return WEAPONTYPE_UNARMED;
+	}
+}
+
+int GetVrWeaponTypeForSlot(int slot)
+{
+	CPed *player = FindPlayerPed();
+	if(!player || slot < 0 || slot >= TOTAL_WEAPON_SLOTS)
+		return -1;
+	eWeaponType type = GetWeaponTypeForSlot(slot);
+	return player->HasWeapon(type) ? (int)type : -1;
+}
+
+bool IsVrWeaponSlotOwned(int slot)
+{
+	CPed *player = FindPlayerPed();
+	if(!player || slot < 0 || slot >= TOTAL_WEAPON_SLOTS)
+		return false;
+	if(slot == WEAPONSLOT_UNARMED)
+		return true;
+	if(slot == WEAPONSLOT_PROJECTILE)
+		return player->HasWeapon(WEAPONTYPE_GRENADE) || player->HasWeapon(WEAPONTYPE_MOLOTOV);
+	if(slot == WEAPONSLOT_RIFLE)
+		return player->HasWeapon(WEAPONTYPE_AK47) || player->HasWeapon(WEAPONTYPE_M16);
+	if(slot == WEAPONSLOT_HEAVY)
+		return player->HasWeapon(WEAPONTYPE_ROCKETLAUNCHER) || player->HasWeapon(WEAPONTYPE_FLAMETHROWER);
+	return player->HasWeapon(GetWeaponTypeForSlot(slot));
+}
