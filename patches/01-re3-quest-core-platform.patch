+bool ActivateVrCheat(int index)
+{
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		if(!FindPlayerPed())
+			return false;
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		if(model < 0)
+			return false;
+		VehicleCheat(model);
+		gVrCycleCarCursor = model < MI_LAST_VEHICLE ?
+			model+1 : MI_FIRST_VEHICLE;
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_BOAT){
+		if(!FindPlayerPed()) return false;
+		VrBoatCheat(gVrCycleBoatModels[gVrCycleBoatIndex %
+			ARRAY_SIZE(gVrCycleBoatModels)]);
+		gVrCycleBoatIndex = (gVrCycleBoatIndex+1)%
+			ARRAY_SIZE(gVrCycleBoatModels);
+		return true;
+	}
+	if(index == VR_SPECIAL_GOD_MODE){
+		if(!FindPlayerPed())
+			return false;
+		SetVrGodMode(!gVrGodModeEnabled);
+		return true;
+	}
+	if(index == VR_SPECIAL_RUN_WITHOUT_LIMITS){
+#if defined(GTA_VR_OCULUS) || defined(GTA_VR_WEAPONS)
+		OculusVR::SetRunWithoutLimitsEnabled(
+			!OculusVR::IsRunWithoutLimitsEnabled());
+		ApplyVrRunWithoutLimits();
+		return true;
+#else
+		return false;
+#endif
+	}
+	if(index == VR_SPECIAL_NEVER_WANTED){
+		CPlayerPed *player = FindPlayerPed();
+		if(!player || !player->m_pWanted)
+			return false;
+		player->m_pWanted->SetNoWantedCheat(!CWanted::bNoWantedCheat);
+		return true;
+	}
+	if(index == VR_SPECIAL_CAR_INVINCIBILITY){
+		if(!FindPlayerPed())
+			return false;
+		SetVrCarInvincibility(!gVrCarInvincibilityEnabled);
+		return true;
+	}
+	const int legacyIndex = index-VR_SPECIAL_CHEAT_COUNT;
+	if(!FindPlayerPed() && !(legacyIndex >= 12 && legacyIndex <= 16))
+		return false;
+	switch(legacyIndex){
+	case 0: WeaponCheat(); break;
+	case 1: HealthCheat(); break;
+	case 2: ArmourCheat(); break;
+	case 3: MoneyCheat(); break;
+	case 4: WantedLevelUpCheat(); break;
+	case 5: WantedLevelDownCheat(); break;
+	case 6: TankCheat(); break;
+	case 7: BlowUpCarsCheat(); break;
+	case 8: ChangePlayerCheat(); break;
+	case 9: MayhemCheat(); break;
+	case 10: EverybodyAttacksPlayerCheat(); break;
+	case 11: WeaponsForAllCheat(); break;
+	case 12: SunnyWeatherCheat(); break;
+	case 13: CloudyWeatherCheat(); break;
+	case 14: RainyWeatherCheat(); break;
+	case 15: FoggyWeatherCheat(); break;
+	case 16: FastWeatherCheat(); break;
+	case 17: FastTimeCheat(); break;
