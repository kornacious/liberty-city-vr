+static const uint8 *
+GetVrMissionCategoryEntries(int category, int *count)
+{
+	if (!count)
+		return nil;
+	switch (category) {
+	case VR_MISSION_CATEGORY_PORTLAND:
+		*count = ARRAY_SIZE(gVrPortlandMissions);
+		return gVrPortlandMissions;
+	case VR_MISSION_CATEGORY_STAUNTON:
+		*count = ARRAY_SIZE(gVrStauntonMissions);
+		return gVrStauntonMissions;
+	case VR_MISSION_CATEGORY_SHORESIDE:
+		*count = ARRAY_SIZE(gVrShoresideMissions);
