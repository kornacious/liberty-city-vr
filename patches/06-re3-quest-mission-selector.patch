 #ifdef MISSION_SWITCHER
+bool
+CTheScripts::TrySwitchToMission(int32 mission)
+{
+	if (!bUsingAMultiScriptFile || mission < 0 ||
+	    mission >= NumberOfMissionScripts ||
+	    mission >= MAX_NUM_MISSION_SCRIPTS ||
+	    MultiScriptArray[mission] <= 0)
+		return false;
+
+	// A running mission can only be unwound after its death/arrest return
+	// frame exists. Starting another mission during an early setup/cutscene
+	// window would corrupt the shared mission script area.
+	for (CRunningScript *script = pActiveScripts; script; script = script->GetNext()) {
+		if (!script->m_bIsMissionScript)
+			continue;
+		if (!script->m_bDeatharrestEnabled || script->m_nStackPointer < 1)
+			return false;
+	}
+
+#ifdef USE_DEBUG_SCRIPT_LOADER
+	int handle = OpenScript();
+#else
+	CFileMgr::ChangeDir("\\");
+	int handle = CFileMgr::OpenFile("data\\main.scm", "rb");
+#endif
+	if (handle == 0)
+		return false;
+	uint8 missionHeader[2];
+	const bool seekFailed = CFileMgr::Seek(handle, MultiScriptArray[mission], 0);
+	const bool offsetReadable = !seekFailed &&
+		CFileMgr::Read(handle, (char*)missionHeader, sizeof(missionHeader)) == sizeof(missionHeader);
+	CFileMgr::CloseFile(handle);
+	if (!offsetReadable)
+		return false;
+
+	SwitchToMission(mission);
+	return bAlreadyRunningAMissionScript;
+}
