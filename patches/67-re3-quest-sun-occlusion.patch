+#ifdef RW_VULKAN
+// The 150 m sun position is only a projection/size reference. It must not
+// limit visibility: distant buildings can still cover the sun. Trace from
+// the current render camera to the visible far plane along the sun ray.
+static bool
+QuestSunSightClear(void)
+{
+	const CVector origin = TheCamera.GetPosition();
+	const CVector direction = CTimeCycle::GetSunDirection();
+	// World LOS indexes sectors directly. Never pass an endpoint outside it.
+	const float minX = WORLD_MIN_X + 0.1f, maxX = WORLD_MAX_X - 0.1f;
+	const float minY = WORLD_MIN_Y + 0.1f, maxY = WORLD_MAX_Y - 0.1f;
+	if(origin.x < minX || origin.x > maxX || origin.y < minY || origin.y > maxY)
+		return true;
+	const float forward = DotProduct(direction, TheCamera.GetForward());
+	float distance = Max(150.0f, RwCameraGetFarClipPlane(Scene.camera) / Max(forward, 0.1f));
+	if(direction.x > 0.0f) distance = Min(distance, (maxX-origin.x)/direction.x);
+	if(direction.x < 0.0f) distance = Min(distance, (minX-origin.x)/direction.x);
+	if(direction.y > 0.0f) distance = Min(distance, (maxY-origin.y)/direction.y);
+	if(direction.y < 0.0f) distance = Min(distance, (minY-origin.y)/direction.y);
+	return CWorld::GetIsLineOfSightClear(origin, origin + direction*distance,
+		true, false, false, false, false, false);
+}
+#endif
