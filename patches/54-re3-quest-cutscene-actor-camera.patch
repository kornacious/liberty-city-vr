 CCutsceneObject::CCutsceneObject(void)
 {
@@ -85,14 +88,46 @@
 void
 CCutsceneObject::Render(void)
 {
+	bool hideHead = false;
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	hideHead = androidgame::VrCutsceneCameraActor() == (void*)this;
+#endif
+	RwMatrix *headMatrix = nil;
+	RwFrame *headFrame = nil;
+	RwMatrix savedHead;
+	if(hideHead){
+#ifdef PED_SKIN
+		if(IsClumpSkinned(GetClump())){
+			RpHAnimHierarchy *hier = GetAnimHierarchyFromSkinClump(GetClump());
+			int index = hier != nil ? RpHAnimIDGetIndex(hier, BONE_head) : -1;
+			if(index >= 0 && RpHAnimHierarchyGetMatrixArray(hier) != nil)
+				headMatrix = &RpHAnimHierarchyGetMatrixArray(hier)[index];
+		}else
+#endif
+		{
+			AnimBlendFrameData *head = RpAnimBlendClumpFindFrame(GetClump(), "Shead");
+			headFrame = head != nil ? head->frame : nil;
+			if(headFrame != nil) headMatrix = RwFrameGetMatrix(headFrame);
+		}
+		if(headMatrix != nil){
+			savedHead = *headMatrix;
+			RwV3d zero = {0.0f, 0.0f, 0.0f};
+			RwMatrixScale(headMatrix, &zero, rwCOMBINEPRECONCAT);
+			if(headFrame != nil) RwFrameUpdateObjects(headFrame);
+		}
+	}
 #ifdef PED_SKIN
 	if(IsClumpSkinned(GetClump())){
 		if(bRenderLeftHand) RenderLimb(BONE_Lhand);
 		if(bRenderRightHand) RenderLimb(BONE_Rhand);
-		if(bRenderHead) RenderLimb(BONE_head);
+		if(bRenderHead && !hideHead) RenderLimb(BONE_head);
 	}
 #endif
 	CObject::Render();
+	if(headMatrix != nil){
+		*headMatrix = savedHead;
+		if(headFrame != nil) RwFrameUpdateObjects(headFrame);
+	}
 }
 
