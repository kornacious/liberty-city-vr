+static CVehicle *
+VrBoatCheat(int model)
+{
+	CHud::SetHelpMessage(TheText.Get("CHEAT1"), true);
+	CStreaming::RequestModel(model, STREAMFLAGS_DONT_REMOVE);
+	CStreaming::LoadAllRequestedModels(false);
+	if(CStreaming::ms_aInfoForModel[model].m_loadState != STREAMSTATE_LOADED)
+		return nil;
+	if(!(CStreaming::ms_aInfoForModel[model].m_loadState & STREAMFLAGS_DONT_REMOVE)){
+		CStreaming::SetModelIsDeletable(model);
+		CStreaming::SetModelTxdIsDeletable(model);
+	}
+	const CVector player = FindPlayerCoors();
+	CVector spawn;
+	bool found = false;
+	for(int ring = 0; ring < 8 && !found; ring++){
+		const float radius = 8.0f+ring*6.0f;
+		for(int step = 0; step < 12 && !found; step++){
+			const float angle = DEGTORAD(step*30.0f);
+			CVector candidate(player.x+Cos(angle)*radius,
+				player.y+Sin(angle)*radius, player.z);
+			float level = 0.0f;
+			if(!CWaterLevel::GetWaterLevelNoWaves(candidate.x, candidate.y,
+			     candidate.z, &level))
+				continue;
+			candidate.z = level+1.0f;
+			if(!CWorld::GetIsLineOfSightClear(candidate,
+			     candidate+CVector(0.0f, 0.0f, 6.0f), true, false, false,
+			     false, false, false))
+				continue;
+			spawn = candidate;
+			found = true;
+		}
+	}
+	if(!found)
+		return nil;
+	CBoat *boat = new CBoat(model, RANDOM_VEHICLE);
+	if(boat == nil)
+		return nil;
+	boat->SetPosition(spawn);
+	boat->SetOrientation(0.0f, 0.0f, DEGTORAD(200.0f));
+	boat->SetStatus(STATUS_ABANDONED);
+	boat->m_nDoorLock = CARLOCK_UNLOCKED;
+	CWorld::Add(boat);
+	return boat;
+}
+
