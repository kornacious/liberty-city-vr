+static bool
+IsVrCycleCarModel(int model)
+{
+	switch(model){
+	case MI_RCBANDIT:
+	case MI_CHOPPER:
+	case MI_AIRTRAIN:
+	case MI_DEADDODO:
+	case MI_ESCAPE:
+	case MI_TRAIN:
+		return false;
+	default:
+		break;
+	}
+	if(CModelInfo::IsBoatModel(model))
+		return false;
+	CBaseModelInfo *base = CModelInfo::GetModelInfo(model);
+	if(!base)
+		return false;
+	CVehicleModelInfo *vehicle = (CVehicleModelInfo*)base;
+	return vehicle->m_vehicleType == VEHICLE_TYPE_CAR;
+}
+
+static int
+FindVrCycleCarModel(int start)
+{
+	const int count = MI_LAST_VEHICLE-MI_FIRST_VEHICLE+1;
+	int model = Min(Max(start, (int)MI_FIRST_VEHICLE),
+		(int)MI_LAST_VEHICLE);
+	for(int checked = 0; checked < count; checked++){
+		if(IsVrCycleCarModel(model))
+			return model;
+		model++;
+		if(model > MI_LAST_VEHICLE)
+			model = MI_FIRST_VEHICLE;
+	}
+	return -1;
+}
+
+static int
+FindVrCycleCarModelDirection(int start, int direction)
+{
+	const int count = MI_LAST_VEHICLE-MI_FIRST_VEHICLE+1;
+	direction = direction < 0 ? -1 : 1;
+	int model = start;
+	while(model < MI_FIRST_VEHICLE) model += count;
+	while(model > MI_LAST_VEHICLE) model -= count;
+	for(int checked = 0; checked < count; checked++){
+		if(IsVrCycleCarModel(model)) return model;
+		model += direction;
+		if(model > MI_LAST_VEHICLE) model = MI_FIRST_VEHICLE;
+		if(model < MI_FIRST_VEHICLE) model = MI_LAST_VEHICLE;
+	}
+	return -1;
+}
+
+static void
+CycleVrModelIndex(int &index, int count, int direction)
+{
+	if(count > 0 && direction != 0)
+		index = (index+count+(direction > 0 ? 1 : -1))%count;
+}
+
+const char *
+GetVrVehicleModelName(int model)
+{
+	CBaseModelInfo *modelInfo =
+		model >= MI_FIRST_VEHICLE && model <= MI_LAST_VEHICLE ?
+		CModelInfo::GetModelInfo(model) : nil;
+	return modelInfo && modelInfo->GetModelName() ?
+		modelInfo->GetModelName() : "UNKNOWN";
+}
+
+// Rank by name and model ID without caching metadata across game loads.
+int GetVrSpawnVehicleCount(void)
+{
+	int count = 0;
+	for(int model = MI_FIRST_VEHICLE; model <= MI_LAST_VEHICLE; ++model)
+		if(IsVrCycleCarModel(model) || CModelInfo::IsBoatModel(model)) ++count;
+	return count;
+}
+
+int GetVrSpawnVehicleModel(int index)
+{
+	for(int model = MI_FIRST_VEHICLE; model <= MI_LAST_VEHICLE; ++model){
+		if(!IsVrCycleCarModel(model) && !CModelInfo::IsBoatModel(model)) continue;
+		int rank = 0;
+		for(int other = MI_FIRST_VEHICLE; other <= MI_LAST_VEHICLE; ++other){
+			if(!IsVrCycleCarModel(other) && !CModelInfo::IsBoatModel(other)) continue;
+			const int order = strcasecmp(GetVrVehicleModelName(other), GetVrVehicleModelName(model));
+			if(order < 0 || (order == 0 && other < model)) ++rank;
+		}
+		if(rank == index) return model;
+	}
+	return -1;
+}
+
+static bool SpawnVrVehicleImpl(int model, bool inside, bool replay)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if(!player || (inside && ((!replay && player->bInVehicle) ||
+		(!player->bInVehicle && !player->IsPedInControl())))) return false;
+	if(model < MI_FIRST_VEHICLE || model > MI_LAST_VEHICLE) return false;
+	CVehicle *vehicle = nil;
+	if(CModelInfo::IsBoatModel(model)){
+		vehicle = VrBoatCheat(model);
+	}else{
+		if(!IsVrCycleCarModel(model)) return false;
+		CStreaming::RequestModel(model, 0);
+		CStreaming::LoadAllRequestedModels(false);
+		if(CStreaming::ms_aInfoForModel[model].m_loadState != STREAMSTATE_LOADED) return false;
+		const int32 node = ThePaths.FindNodeClosestToCoors(FindPlayerCoors(), PATH_CAR, 100.0f);
+		if(node < 0) return false;
+		vehicle = new CAutomobile(model, RANDOM_VEHICLE);
+		if(!vehicle) return false;
+		CVector position = ThePaths.m_pathNodes[node].GetPosition();
+		position.z += inside ? 0.5f : 4.0f;
+		vehicle->SetPosition(position);
+		vehicle->SetOrientation(0.0f, 0.0f, DEGTORAD(200.0f));
+		vehicle->SetStatus(STATUS_ABANDONED);
+		vehicle->m_nDoorLock = CARLOCK_UNLOCKED;
+		CWorld::Add(vehicle);
+	}
+	if(!vehicle) return false;
+	if(inside){
+		// Allocate/load first so a failed replay spawn leaves the player seated.
+		if(replay && player->bInVehicle && player->m_pMyVehicle){
+			CVehicle *previous = player->m_pMyVehicle;
+			if(previous->pDriver == player){
+				previous->RemoveDriver();
+				previous->SetStatus(STATUS_ABANDONED);
+				previous->bEngineOn = false;
+				previous->AutoPilot.m_nCruiseSpeed = 0;
+			}else previous->RemovePassenger(player);
+			player->bInVehicle = false;
+			player->m_pMyVehicle = nil;
+			player->bRenderPedInCar = true;
+			player->RemoveInCarAnims();
+			player->m_pVehicleAnim = nil;
+			player->ClearObjective();
+			player->SetPedState(PED_IDLE);
+			AudioManager.PlayerJustLeftCar();
+		}
+		player->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, vehicle);
+		player->WarpPedIntoCar(vehicle);
+	}
+	return true;
+}
+
+bool SpawnVrVehicle(int model, bool inside)
+{
+	return SpawnVrVehicleImpl(model, inside, false);
+}
+
+bool SpawnVrVehicleForReplay(int model)
+{
+	return SpawnVrVehicleImpl(model, true, true);
+}
