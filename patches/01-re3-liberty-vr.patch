+
+static RpAtomic*
+GetVrHolsterWeaponAtomic(int slot, int modelId)
+{
+	if(slot < 0 || slot >= TOTAL_WEAPON_SLOTS || modelId < 0)
+		return nil;
+	if(gVrHolsterWeaponCache[slot].modelId != modelId)
+		ReleaseVrHolsterWeapon(gVrHolsterWeaponCache[slot]);
+	if(!gVrHolsterWeaponCache[slot].atomic){
+		if(!CStreaming::HasModelLoaded(modelId))
+			return nil;
+		CBaseModelInfo *modelInfo = CModelInfo::GetModelInfo(modelId);
+		if(!modelInfo)
+			return nil;
+		gVrHolsterWeaponCache[slot].atomic = (RpAtomic*)modelInfo->CreateInstance();
+		if(!gVrHolsterWeaponCache[slot].atomic)
+			return nil;
+		modelInfo->AddRef();
+		gVrHolsterWeaponCache[slot].modelId = modelId;
+	}
+	return gVrHolsterWeaponCache[slot].atomic;
+}
