+namespace {
+struct AutosaveOperations {
+	bool Write(const char *path) {
+		const int file = CFileMgr::OpenFile(path, "wb");
+		if(file == 0) return false;
+		const bool written = GenericSave(file);
+		// GenericSave closes on some failures. Closing again is harmless in
+		// CFileMgr and releases the handle on every other failure path.
+		const bool closed = CFileMgr::CloseFile(file) == 0;
+		return written && closed;
+	}
+	bool Exists(const char *path) {
+		struct stat info;
+		return stat(path, &info) == 0;
+	}
+	bool Validate(const char *path) {
+		char name[sizeof(LoadFileName)];
+		const int checksum = CheckSum;
+		const eLevelName level = m_LevelToLoad;
+		const auto error = PcSaveHelper.nErrorCode;
+		const bool valid = CheckSaveFile(path, name, AUTOSAVE_SLOT);
+		CheckSum = checksum;
+		m_LevelToLoad = level;
+		PcSaveHelper.nErrorCode = error;
+		return valid;
+	}
+	bool Sync(const char *path) {
+		const int file = open(path, O_RDWR);
+		if(file < 0) return false;
+		const bool synced = fsync(file) == 0;
+		const bool closed = close(file) == 0;
+		return synced && closed;
+	}
+	bool Copy(const char *source, const char *destination) {
+		FILE *input = fopen(source, "rb");
+		if(!input) return false;
+		FILE *output = fopen(destination, "wb");
+		if(!output){ fclose(input); return false; }
+		char buffer[16384];
+		bool copied = true;
+		size_t count;
+		while((count = fread(buffer, 1, sizeof(buffer), input)) != 0)
+			if(fwrite(buffer, 1, count, output) != count){ copied = false; break; }
+		if(ferror(input)) copied = false;
+		const bool inputClosed = fclose(input) == 0;
+		const bool outputClosed = fclose(output) == 0;
+		return copied && inputClosed && outputClosed;
+	}
+	bool Replace(const char *source, const char *destination) {
+		#ifdef _WIN32
+        return MoveFileExA(source,destination,MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+        return rename(source, destination) == 0;
+#endif
+	}
+	bool SyncDirectory(const char *path) {
+#ifdef _WIN32
+        // Files are committed before MoveFileEx WRITE_THROUGH; Win32 does not
+        // expose POSIX directory fsync through the CRT.
+        return true;
+#else
+		char directory[260];
+		const int length = snprintf(directory, sizeof(directory), "%s", path);
+		if(length < 0 || size_t(length) >= sizeof(directory)) return false;
+		char *slash = strrchr(directory, '/');
+		if(slash) { if(slash == directory) slash[1] = '\0'; else *slash = '\0'; }
+		else strcpy(directory, ".");
+		const int file = open(directory, O_RDONLY | O_DIRECTORY);
+		if(file < 0) return false;
+		const int result = fsync(file);
+		const int error = errno;
+		close(file);
+		// Some emulated-storage providers do not expose directory fsync.
+		// File fsync and atomic replacement are still required above.
+		if(result != 0 && (error == EINVAL || error == EOPNOTSUPP)){
+			SAVELOG("autosave directory fsync unavailable: %d", error);
+			return true;
+		}
+		return result == 0;
+#endif
+	}
+	void Remove(const char *path) { unlink(path); }
+};
+}
