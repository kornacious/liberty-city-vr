+void
+CHeli::ProcessAvoidance(CVector2D &targetSpeed, const CVector2D &vTargetDist)
+{
+#if (defined(__ANDROID__) || (defined(LIBERTYVR_WINDOWS) || defined(LIBERTYVR_DESKTOP))) && defined(FIX_BUGS)
+	if(m_heliStatus != HELI_STATUS_HOVER2 && m_heliStatus != HELI_STATUS_SHOT_DOWN){
+		m_fAvoidanceSideSpeed = 0.0f;
+		// Preserve the legacy two-unit recovery and its terminal remainder.
+		for(uint32 i = 0; i < QuestGameTime::Count(); i++)
+			if(m_fTargetOffset >= 2.0f)
+				m_fTargetOffset -= 2.0f;
+		return;
+	}
+
+	for(uint32 i = 0; i < QuestGameTime::Count(); i++){
+		const bool force = !!((QuestGameTime::Tick(i) + m_randomSeed) & 8);
+		const float side = m_bTestRight ? 1.0f : -1.0f;
+		if(force || CWorld::TestSphereAgainstWorld(GetPosition() + side*4.0f*GetRight(), 2.0f, this, true, false, false, false, false, false) == nil){
+			if(m_heliStatus == HELI_STATUS_SHOT_DOWN){
+				m_fTargetOffset -= (50.0f/30.0f)*0.05f;
+				m_fAvoidanceSideSpeed = side*0.15f;
+			}else
+				m_fAvoidanceSideSpeed = side*0.05f;
+		}else{
+			m_bTestRight = !m_bTestRight;
+			m_fTargetOffset += m_heliStatus == HELI_STATUS_HOVER2 ? 5.0f : -5.0f;
+			m_fAvoidanceSideSpeed = 0.0f;
+		}
+		if(m_fTargetOffset > 30.0f)
+			m_fTargetOffset = 30.0f;
+
+		if(m_heliStatus == HELI_STATUS_SHOT_DOWN && force){
+			if(CWorld::TestSphereAgainstWorld(GetPosition() + 1.5f*GetForward(), 2.0f, this, true, false, false, false, false, false) ||
+			   CWorld::TestSphereAgainstWorld(GetPosition() - 1.5f*GetForward(), 2.0f, this, true, false, false, false, false, false))
+				m_nExplosionTimer = CTimer::GetPreviousTimeInMilliseconds();
+		}
+	}
+	// Hold the latest decision between ticks; flight integration still uses dt.
+	targetSpeed.x += vTargetDist.x*m_fAvoidanceSideSpeed;
+	targetSpeed.y += vTargetDist.y*m_fAvoidanceSideSpeed;
+#else
+	if(m_heliStatus == HELI_STATUS_HOVER2 || m_heliStatus == HELI_STATUS_SHOT_DOWN){
+		bool force = !!((CTimer::GetFrameCounter() + m_randomSeed) & 8);
+		if(m_bTestRight){
+			if(force || CWorld::TestSphereAgainstWorld(GetPosition() + 4.0f*GetRight(), 2.0f, this, true, false, false, false, false, false) == nil){
+				if(m_heliStatus == HELI_STATUS_SHOT_DOWN){
+					m_fTargetOffset -= CTimer::GetTimeStep()*0.05f;
+					targetSpeed.x -= -vTargetDist.x*0.15f;
+					targetSpeed.y -= vTargetDist.y*0.15f;
+				}else{
+					targetSpeed.x -= -vTargetDist.x*0.05f;
+					targetSpeed.y -= vTargetDist.y*0.05f;
+				}
+			}else{
+				m_bTestRight = false;
+				if(m_heliStatus == HELI_STATUS_HOVER2)
+					m_fTargetOffset += 5.0f;
+				else
+					m_fTargetOffset -= 5.0f;
+			}
+		}else{
+			if(force || CWorld::TestSphereAgainstWorld(GetPosition() - 4.0f*GetRight(), 2.0f, this, true, false, false, false, false, false) == nil){
+				if(m_heliStatus == HELI_STATUS_SHOT_DOWN){
+					m_fTargetOffset -= CTimer::GetTimeStep()*0.05f;
+					targetSpeed.x += -vTargetDist.x*0.15f;
+					targetSpeed.y += vTargetDist.y*0.15f;
+				}else{
+					targetSpeed.x += -vTargetDist.x*0.05f;
+					targetSpeed.y += vTargetDist.y*0.05f;
+				}
+			}else{
+				m_bTestRight = true;
+				if(m_heliStatus == HELI_STATUS_HOVER2)
+					m_fTargetOffset += 5.0f;
+				else
+					m_fTargetOffset -= 5.0f;
+			}
+		}
+
+		if(m_fTargetOffset > 30.0f)
+			m_fTargetOffset = 30.0f;
+
+		if(m_heliStatus == HELI_STATUS_SHOT_DOWN && force){
+			if(CWorld::TestSphereAgainstWorld(GetPosition() + 1.5f*GetForward(), 2.0f, this, true, false, false, false, false, false) ||
+			   CWorld::TestSphereAgainstWorld(GetPosition() - 1.5f*GetForward(), 2.0f, this, true, false, false, false, false, false))
+				m_nExplosionTimer = CTimer::GetPreviousTimeInMilliseconds();
+		}
+	}else
+		if(m_fTargetOffset >= 2.0f)
+			m_fTargetOffset -= 2.0f;
+
+#endif
+}
