+static bool gVrCarInvincibilityEnabled = false;
+// The engine clears this registered reference if the vehicle is deleted.
+static CVehicle *gVrInvincibleVehicle = nil;
+static struct {
+	bool canBeDamaged, bulletProof, fireProof, collisionProof, meleeProof, explosionProof;
+} gVrVehicleProtection;
+
+static void
+RestoreVrCarProtection(void)
+{
+	CVehicle *veh = gVrInvincibleVehicle;
+	if(!veh)
+		return;
+	veh->bCanBeDamaged = gVrVehicleProtection.canBeDamaged;
+	veh->bBulletProof = gVrVehicleProtection.bulletProof;
+	veh->bFireProof = gVrVehicleProtection.fireProof;
+	veh->bCollisionProof = gVrVehicleProtection.collisionProof;
+	veh->bMeleeProof = gVrVehicleProtection.meleeProof;
+	veh->bExplosionProof = gVrVehicleProtection.explosionProof;
+	gVrInvincibleVehicle = nil;
+	veh->PruneReferences();
+}
+
+static void
+ApplyVrCarInvincibility(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	CVehicle *veh = gVrCarInvincibilityEnabled ? FindPlayerVehicle() : nil;
+	if(!player || (veh && veh->pDriver != player))
+		veh = nil;
+	if(veh != gVrInvincibleVehicle)
+		RestoreVrCarProtection();
+	if(!veh)
+		return;
+	if(!gVrInvincibleVehicle){
+		// Preserve actual mission/model protection before the first override.
+		gVrVehicleProtection = {bool(veh->bCanBeDamaged), bool(veh->bBulletProof),
+			bool(veh->bFireProof), bool(veh->bCollisionProof), bool(veh->bMeleeProof), bool(veh->bExplosionProof)};
+		gVrInvincibleVehicle = veh;
+		veh->RegisterReference((CEntity**)&gVrInvincibleVehicle);
+		if(veh->m_vehType == VEHICLE_TYPE_CAR)
+			((CAutomobile*)veh)->Fix();
+	}
+	veh->bCanBeDamaged = false;
+	veh->bBulletProof = true;
+	veh->bFireProof = true;
+	veh->bCollisionProof = true;
+	veh->bMeleeProof = true;
+	veh->bExplosionProof = true;
+	if(veh->m_fHealth < 1000.0f)
+		veh->m_fHealth = 1000.0f;
+	veh->ExtinguishCarFire();
+	if(veh->m_vehType == VEHICLE_TYPE_CAR)
+		((CAutomobile*)veh)->Damage.SetEngineStatus(0);
+}
+
+static void
+SetVrCarInvincibility(bool enabled)
+{
+	gVrCarInvincibilityEnabled = enabled;
+	ApplyVrCarInvincibility();
+}
