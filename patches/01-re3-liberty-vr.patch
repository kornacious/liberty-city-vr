+void
+CPed::ReactToTrackedGun(void)
+{
+	// Physical aim has no legacy lock-on target or PED_AIM_GUN state.
+	// Deliver the original reaction independently of gunshots/fear flags.
+	// Cops retain the wanted-level and disabled-cop guards in ScanForCrimes.
+	if (IsPlayer() || m_nPedType == PEDTYPE_COP || !IsPedInControl() ||
+		CharCreatedBy == MISSION_CHAR ||
+		((CTimer::GetFrameCounter() + (uint8)m_randomSeed) & 3) != 0)
