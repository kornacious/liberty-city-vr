+bool GetVrCheatToggleState(int index, bool *enabled)
+{
+	if(enabled && index == VR_SPECIAL_CHEAT_COUNT+16){
+		*enabled = gbFastTime;
+		return true;
+	}
+	if(enabled && index == VR_SPECIAL_CHEAT_COUNT+30){
+		*enabled=VrPlayerTraversal::Flight(); return true;
+	}
+	if(enabled && index == VR_SPECIAL_CHEAT_COUNT+31){
+		*enabled=VrPlayerTraversal::Noclip(); return true;
+	}
+	if(enabled && index == VR_SPECIAL_CHEAT_COUNT+29){
+		*enabled = COnscreenTimer::bVrMissionTimerStopped;
+		return true;
+	}
+	if(!enabled)
+		return false;
+	if(index == VR_SPECIAL_NEVER_WANTED){
+		*enabled = CWanted::bNoWantedCheat;
+		return true;
+	}
+	if(index == VR_SPECIAL_GOD_MODE){
+		*enabled = gVrGodModeEnabled;
+		return true;
+	}
+	if(index == VR_SPECIAL_RUN_WITHOUT_LIMITS){
+		*enabled = IsVrRunWithoutLimitsEnabled();
+		return true;
+	}
+	if(index == VR_SPECIAL_CAR_INVINCIBILITY){
+		*enabled = gVrCarInvincibilityEnabled;
+		return true;
+	}
+	if(index == VR_SPECIAL_CHEAT_COUNT+32){
+		*enabled = CVehicle::bVrDoorLockEnabled;
+		return true;
+	}
+	return false;
+}
+
+const char *GetVrCheatName(int index)
+{
+	static char carName[64];
+	static char boatName[64];
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		sprintf(carName, "SPAWN NEXT CAR - %s",
+			GetVrVehicleModelName(model));
+		return carName;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_BOAT){
+		const int model = gVrCycleBoatModels[gVrCycleBoatIndex %
+			ARRAY_SIZE(gVrCycleBoatModels)];
+		sprintf(boatName, "SPAWN BOAT - %s",
+			GetVrVehicleModelName(model));
+		return boatName;
+	}
+	if(index == VR_SPECIAL_GOD_MODE)
+		return gVrGodModeEnabled ?
+			"GOD MODE - ON" : "GOD MODE - OFF";
+	if(index == VR_SPECIAL_RUN_WITHOUT_LIMITS)
+		return IsVrRunWithoutLimitsEnabled() ?
+			"RUN WITHOUT LIMITS - ON" : "RUN WITHOUT LIMITS - OFF";
+	if(index == VR_SPECIAL_NEVER_WANTED)
+		return CWanted::bNoWantedCheat ?
+			"NEVER WANTED - ON" : "NEVER WANTED - OFF";
+	if(index == VR_SPECIAL_CAR_INVINCIBILITY)
+		return gVrCarInvincibilityEnabled ?
+			"CAR INVINCIBILITY - ON" : "CAR INVINCIBILITY - OFF";
+	const int legacy = index-VR_SPECIAL_CHEAT_COUNT;
+	return legacy >= 0 && legacy < (int)ARRAY_SIZE(gVrCheatNames) ?
+		gVrCheatNames[legacy] : "UNKNOWN";
+}
+
+bool
+CycleVrCheatSelection(int index, int direction)
+{
+	if(direction == 0) return false;
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		const int current = FindVrCycleCarModel(gVrCycleCarCursor);
+		if(current < 0) return false;
+		gVrCycleCarCursor = FindVrCycleCarModelDirection(
+			current+(direction > 0 ? 1 : -1), direction);
+		return gVrCycleCarCursor >= 0;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_BOAT){
+		CycleVrModelIndex(gVrCycleBoatIndex,
+			ARRAY_SIZE(gVrCycleBoatModels), direction);
+		return true;
+	}
+	return false;
+}
